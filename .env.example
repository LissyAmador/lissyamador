# Copia este archivo como .env.local y rellena los valores.

# Clave de acceso de Web3Forms: define a qué buzón llegan los mensajes del
# formulario de contacto. Se obtiene gratis en https://web3forms.com
# introduciendo el correo de destino; la clave llega por correo.
# Es pública por diseño (viaja al navegador), así que no es un secreto.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Dominio definitivo del sitio, para el sitemap y las metaetiquetas.
NEXT_PUBLIC_SITE_URL=https://lissyamador.com
